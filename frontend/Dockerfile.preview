# PR preview-only image. Does not affect the main frontend Dockerfile.

# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

ARG BUILD_CONFIGURATION=staging
ARG API_URL=

COPY package*.json ./
RUN npm ci

COPY . .
RUN if [ -n "$API_URL" ]; then \
      sed -i "s|__API_URL__|$API_URL|g" src/environments/environment.staging.ts src/environments/environment.prod.ts; \
    fi \
    && npm run build -- --configuration "$BUILD_CONFIGURATION"

# Stage 2: Runtime
FROM nginx:stable-alpine

COPY --from=build /app/dist/shopp-mate-front/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
